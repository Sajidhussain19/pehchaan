# Copy this file to `.env` and fill in your real values.
# `.env` is in .gitignore, so your key will never be committed.

# Required for any script that calls OpenAI (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default models (defaults live in app/config.py)
# TRANSCRIPTION_MODEL=gpt-4o-transcribe
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# TTS_MODEL=gpt-4o-mini-tts
